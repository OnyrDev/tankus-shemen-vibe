# Godot 4.x .gitignore

# Godot-specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System / OS ignores
.DS_Store
Thumbs.db

# Temp / Editor
*.tmp
*.swp
*~

# Build outputs
build/
*.exe
*.pck
